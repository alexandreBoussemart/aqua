# Pas de listing de répertoires
Options -Indexes

# web/ est le seul dossier public (la racine du projet est fermée par ../.htaccess)
Require all granted

# Fichiers de build / sources à ne pas exposer
<FilesMatch "^(package(-lock)?\.json|gulpfile\.js)$|\.(map|scss|lock|md|sql|zip|bak|log)$">
    Require all denied
</FilesMatch>
RedirectMatch 403 /\.(sass-cache|git)(/|$)

RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

php_flag display_errors 1

<IfModule mod_headers.c>

<FilesMatch "\\.(ico|jpe?g|png|gif|swf)$">
Header set Cache-Control "max-age=2592000, public"
</FilesMatch>

<FilesMatch "\\.(x?html?)$">
Header set Cache-Control "max-age=600, private, must-revalidate"
</FilesMatch>

</IfModule>