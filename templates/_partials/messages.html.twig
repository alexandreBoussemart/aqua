{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="messages">
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }}" role="alert">
                <i class="fa fa-{{ type == 'success' ? 'check-circle' : (type == 'error' ? 'exclamation-circle' : 'info-circle') }}"></i>
                {{ message }}
            </div>
        </div>
    {% endfor %}
{% endfor %}
