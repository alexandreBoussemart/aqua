{% extends 'base.html.twig' %}
{% block title %}Logs{% endblock %}

{% block body %}
    <div class="row first-bloc">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_title"><h2>Log</h2><div class="clearfix"></div></div>
                <div class="x_content2">
                    <table id="datatable" class="table table-striped table-bordered">
                        <thead><tr><th style="width: 25px;">Id</th><th style="width: 25%;">Date</th><th>Log</th></tr></thead>
                        <tbody>
                        {% for log in logs %}
                            <tr><td>{{ log.id }}</td><td>{{ log.created_at|date_fr }}</td><td>{{ log.message }}</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row first-bloc">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_title"><h2>Log mail</h2><div class="clearfix"></div></div>
                <div class="x_content2">
                    <table id="datatable-mail" class="table table-striped table-bordered">
                        <thead><tr><th style="width: 25px;">Id</th><th style="width: 25%;">Date</th><th>Sujet</th><th>Message</th></tr></thead>
                        <tbody>
                        {% for mail in mails %}
                            <tr>
                                <td>{{ mail.id }}</td>
                                <td>{{ mail.created_at|date_fr }}</td>
                                <td>{{ mail.sujet }}</td>
                                {# corps HTML généré par l'application : seules quelques balises de mise en forme sont conservées #}
                                <td>{{ mail.message|striptags('<p><br><ul><li><b><strong><span>')|raw }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row first-bloc">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_title osmo">
                    <h2>Changement d'eau <small>{{ total_litres }} litre{{ total_litres > 1 ? 's' }}</small></h2>
                    <div class="clearfix"></div>
                </div>
                <div class="x_content2">
                    <table id="datatable-eau" class="table table-striped table-bordered">
                        <thead><tr><th style="width: 25px;">Id</th><th style="width: 25%;">Date</th><th>Volume</th><th style="width: 25px;">Supprimer</th></tr></thead>
                        <tbody>
                        {% for change in changes %}
                            <tr>
                                <td>{{ change.id }}</td>
                                <td>{{ change.created_at|date_fr }}</td>
                                <td>{{ change.value }} Litres</td>
                                <td class="action_grid">
                                    <form method="post" action="{{ path('water_change_delete', {id: change.id}) }}" class="form-horizontal form-label-left switch-state">
                                        {{ include('_partials/csrf.html.twig') }}
                                        <button onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette donnée ?')" class="btn btn-default" type="submit">
                                            <i class="fa fa-close"></i>Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        $('#datatable, #datatable-mail, #datatable-eau').dataTable({'order': [[0, 'desc']]});
    </script>
{% endblock %}
