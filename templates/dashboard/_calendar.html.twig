{% set day_names = {Mon: 'Lundi', Tue: 'Mardi', Wed: 'Mercredi', Thu: 'Jeudi', Fri: 'Vendredi', Sat: 'Samedi', Sun: 'Dimanche'} %}
<div class="row">
    <div class="col-md-12 col-xs-12 col-sm-12 content-calendrier">
        <div class="x_panel">
            <div class="x_title"><h2>Calendrier</h2><div class="clearfix"></div></div>
            <div class="x_content">
                <div class="calendrier">
                    {% for day, events in feeding %}
                        <div class="days {{ day == today ? 'today' }}">
                            <div class="title">{{ day_names[day] }}</div>
                            <div class="contenu">
                                {% for class, label in events %}
                                    <div class="event {{ class }}">{{ label }}</div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>
