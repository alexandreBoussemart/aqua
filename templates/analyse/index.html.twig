{% extends 'base.html.twig' %}
{% block title %}Analyse d'eau{% endblock %}

{% block body %}
    <div class="row first-bloc">
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_title"><h2>Analyse d'eau</h2><div class="clearfix"></div></div>
                <form method="post" action="{{ path('analyse_save') }}" class="form-horizontal form-label-left switch-state">
                    {{ include('_partials/csrf.html.twig') }}
                    {% for type, p in params %}
                        {% set s = summaries[type] %}
                        <div class="form-group">
                            <label class="control-label col-md-3 col-sm-3 col-xs-3">{{ p[0] }}</label>
                            <div class="col-md-9 col-sm-9 col-xs-9">
                                <input name="value_{{ type }}" class="form-control col-md-7 col-xs-12" type="text" inputmode="decimal"/>
                                {% if s %}
                                    <p class="info">
                                        {{ s.value }} {{ s.unit }}
                                        {% if s.diff is not null %}
                                            ( <span style="color:{{ s.diff >= 0 ? '#4BB543' : '#B33A3A' }}">{{ s.diff >= 0 ? '+' }}{{ s.diff }} {{ s.unit }} en {{ s.days }} jour{{ s.days > 1 ? 's' }}</span> )
                                        {% endif %}
                                        {{ s.ago }}
                                    </p>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                    <div class="ln_solid"></div>
                    <div class="form-group">
                        <div class="col-md-6 col-sm-6 col-xs-12 col-md-offset-3">
                            <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> Enregistrer</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    {% for row in charts|batch(2) %}
        <div class="row first-bloc">
            {% for chart in row %}
                {{ include('_partials/panel_chart.html.twig', {title: chart.label ~ (chart.unit ? ' (' ~ chart.unit ~ ')' : ''), chart: chart}) }}
            {% endfor %}
        </div>
    {% endfor %}
{% endblock %}
